# --- Phase 1: database & auth ---
# Async Postgres DSN used by SQLAlchemy (asyncpg driver) — Alembic also runs migrations
# asynchronously against this same URL, so no separate sync driver is needed.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/seatflow
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Phase 2: mock payments & frontend origin ---
PAYMENT_GATEWAY_API_KEY=mock-key-anything-works-here
FRONTEND_ORIGIN=http://localhost:3000

# --- Phase 4: error tracking (optional, leave blank to disable) ---
SENTRY_DSN=

# --- App settings ---
ENVIRONMENT=development
SEAT_HOLD_TTL_SECONDS=120
